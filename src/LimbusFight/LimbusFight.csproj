<Project Sdk="Microsoft.NET.Sdk">

  <!-- ===================================================================== -->
  <!-- Limbus Fight - core game project (pure C#, .NET 8, Raylib-cs)          -->
  <!-- ===================================================================== -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Release builds (CI) publish for .NET 10 with -p:TargetFramework=net10.0; the code also builds on .NET 8. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LimbusFight</RootNamespace>
    <AssemblyName>LimbusFight</AssemblyName>
    <Product>Limbus Fight</Product>
    <Description>Limbus Company 2D fighting fangame (unofficial, uses the player's own game files)</Description>
    <ApplicationIcon>Resources\LimbusFight.ico</ApplicationIcon>

    <!-- CI overrides Version with 0.1.<run number> and appends the commit SHA. -->
    <Version>0.1.0</Version>

    <!-- No culture-specific behaviour needed; keeps the published exe smaller. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Embedded PDB = line numbers in LimbusFight_crash.log without a separate .pdb file. -->
    <DebugType>embedded</DebugType>

    <!-- Needed to hand decoded pixels to Raylib without copying (AssetBrowserScreen). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Single-file settings. They only apply when a RuntimeIdentifier is given
    (e.g. dotnet publish -r win-x64), so a plain `dotnet build` / `dotnet run`
    still works as a normal framework-dependent debug build on any OS.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Packs raylib.dll INSIDE LimbusFight.exe; it is extracted to %TEMP%\.net\LimbusFight\ on first launch. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Raylib-cs 8.1.0 = official raylib 6.0 natives for win-x64 / linux-x64 / osx. -->
    <PackageReference Include="Raylib-cs" Version="8.1.0" />

    <!-- Step 2: read Unity bundles (MIT) and decode their textures (MIT). Both are pure managed code. -->
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="AssetRipper.TextureDecoder" Version="2.6.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Original icon (not Project Moon art): exe icon + window icon. -->
    <EmbeddedResource Include="Resources\icon.png" LogicalName="icon.png" />
  </ItemGroup>

</Project>
